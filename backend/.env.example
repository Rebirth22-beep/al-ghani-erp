APP_NAME="Al-Ghani ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=alghani_erp
DB_USERNAME=alghani
DB_PASSWORD=secret

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost:5173

# ========================================================
# LEGACY DATA IMPORT (one-shot migration from C:\xampp\htdocs\alghani)
# ========================================================
# Set LEGACY_IMPORT_ENABLED=true ONLY when running LegacyImportSeeder against
# a SAFE dev database. The seeder reads from the legacy DB and writes to the
# current DB. NEVER enable this on production.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=alghani
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_IMPORT_ENABLED=false
